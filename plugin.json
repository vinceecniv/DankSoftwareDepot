{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "dankSoftwareDepot",
    "name": "Dank Software Depot",
    "description": "Software center for DMS: updates with progress, release notes, app store with reviews, installed-software management, firmware and an action log.",
    "version": "0.7.7",
    "author": "Vincent Blok",
    "license": "MIT",
    "icon": "deployed_code_update",
    "type": "widget",
    "capabilities": [
        "dankbar-widget"
    ],
    "component": "./UpdaterWidget.qml",
    "settings": "./UpdaterSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
